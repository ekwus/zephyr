/dts-v1/;
#include <st/h5/stm32h573Xi.dtsi>
#include <st/h5/stm32h573iikxq-pinctrl.dtsi>
#include "arduino_r3_connector.dtsi"

/ {
    model = "STMicroelectronics STM32H573I-DK board (Non-Secure)";
    compatible = "st,stm32h573i-dk";

    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
        zephyr,sram = &sram1;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_ns_partition;
    };

    leds {
        compatible = "gpio-leds";
        green_led_1: led_1 {
            gpios = <&gpioi 9 GPIO_ACTIVE_LOW>;
            label = "User LD1";
        };
        orange_led_2: led_2 {
            gpios = <&gpioi 8 GPIO_ACTIVE_LOW>;
            label = "User LD2";
        };
        red_led_3: led_3 {
            gpios = <&gpiof 1 GPIO_ACTIVE_LOW>;
            label = "User LD3";
        };
        blue_led_4: led_4 {
            gpios = <&gpiof 4 GPIO_ACTIVE_LOW>;
            label = "User LD4";
        };
    };

    gpio_keys {
        compatible = "gpio-keys";
        user_button: button {
            label = "User";
            gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
        };
    };

    aliases {
        led0 = &green_led_1;
        led1 = &orange_led_2;
        led2 = &red_led_3;
        led3 = &blue_led_4;
        sw0 = &user_button;
    };
};

&clk_hse {
    clock-frequency = <DT_FREQ_M(24)>;
    status = "okay";
};

&clk_hsi48 {
    status = "okay";
};

&clk_lse {
    status = "okay";
};

&pll {
    div-m = <12>;
    mul-n = <250>;
    div-p = <2>;
    div-q = <2>;
    div-r = <2>;
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(250)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <2>;
    apb2-prescaler = <1>;
    apb3-prescaler = <1>;
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /*
         * NOTE: This layout matches TF-M's flash_layout.h expectations
         * TF-M places scratch, BL2 metadata, and storage BEFORE images
         *
         * Layout (updated for larger NS partition - 512KB for HTTPS server):
         * 0x00000-0x38000: BL2 + metadata + storage (224 KB)
         * 0x38000-0x68000: TF-M Secure primary (192 KB)
         * 0x68000-0xE8000: Zephyr NS primary (512 KB)
         * 0xE8000-0x118000: TF-M Secure secondary (192 KB)
         * 0x118000-0x198000: Zephyr NS secondary (512 KB)
         */

        /* BL2 + metadata + storage (not directly accessible) */
        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(224)>;  /* Covers all TF-M overhead */
            read-only;
        };

        /* Secure image primary slot - TF-M @ 0x38000 */
        slot0_partition: partition@38000 {
            label = "image-0";
            reg = <0x00038000 DT_SIZE_K(192)>;
        };

        /* Non-secure image primary slot - 512KB for HTTPS server */
        slot0_ns_partition: partition@68000 {
            label = "image-0-nonsecure";
            reg = <0x00068000 DT_SIZE_K(512)>;
        };

        /* Secure image secondary slot @ 0xE8000 */
        slot1_partition: partition@e8000 {
            label = "image-1";
            reg = <0x000e8000 DT_SIZE_K(192)>;
        };

        /* Non-secure image secondary slot - 512KB */
        slot1_ns_partition: partition@118000 {
            label = "image-1-nonsecure";
            reg = <0x00118000 DT_SIZE_K(512)>;
        };

        /* Storage partition */
        storage_partition: partition@198000 {
            label = "storage";
            reg = <0x00198000 DT_SIZE_K(32)>;
        };
    };
};
