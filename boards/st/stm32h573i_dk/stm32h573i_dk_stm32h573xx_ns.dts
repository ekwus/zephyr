/dts-v1/;
#include <st/h5/stm32h573Xi.dtsi>
#include <st/h5/stm32h573iikxq-pinctrl.dtsi>
#include "arduino_r3_connector.dtsi"

/ {
    model = "STMicroelectronics STM32H573I-DK board (Non-Secure)";
    compatible = "st,stm32h573i-dk";

    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
        zephyr,sram = &sram1;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_ns_partition;
    };

    leds {
        compatible = "gpio-leds";
        green_led_1: led_1 {
            gpios = <&gpioi 9 GPIO_ACTIVE_LOW>;
            label = "User LD1";
        };
        orange_led_2: led_2 {
            gpios = <&gpioi 8 GPIO_ACTIVE_LOW>;
            label = "User LD2";
        };
        red_led_3: led_3 {
            gpios = <&gpiof 1 GPIO_ACTIVE_LOW>;
            label = "User LD3";
        };
        blue_led_4: led_4 {
            gpios = <&gpiof 4 GPIO_ACTIVE_LOW>;
            label = "User LD4";
        };
    };

    gpio_keys {
        compatible = "gpio-keys";
        user_button: button {
            label = "User";
            gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
        };
    };

    aliases {
        led0 = &green_led_1;
        led1 = &orange_led_2;
        led2 = &red_led_3;
        led3 = &blue_led_4;
        sw0 = &user_button;
    };
};

&clk_hse {
    clock-frequency = <DT_FREQ_M(24)>;
    status = "okay";
};

&clk_hsi48 {
    status = "okay";
};

&clk_lse {
    status = "okay";
};

&pll {
    div-m = <12>;
    mul-n = <250>;
    div-p = <2>;
    div-q = <2>;
    div-r = <2>;
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(250)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <2>;
    apb2-prescaler = <1>;
    apb3-prescaler = <1>;
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* Bootloader partition (MCUboot or TF-M) */
        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(64)>;
            read-only;
        };

        /* Secure image primary slot */
        slot0_partition: partition@10000 {
            label = "image-0";
            reg = <0x00010000 DT_SIZE_K(192)>;
        };

        /* Non-secure image primary slot */
        slot0_ns_partition: partition@40000 {
            label = "image-0-nonsecure";
            reg = <0x00040000 DT_SIZE_K(192)>;
        };

        /* Secure image secondary slot */
        slot1_partition: partition@70000 {
            label = "image-1";
            reg = <0x00070000 DT_SIZE_K(192)>;
        };

        /* Non-secure image secondary slot */
        slot1_ns_partition: partition@a0000 {
            label = "image-1-nonsecure";
            reg = <0x000a0000 DT_SIZE_K(192)>;
        };

        /* Storage partition */
        storage_partition: partition@d0000 {
            label = "storage";
            reg = <0x000d0000 DT_SIZE_K(192)>;
        };
    };
};
